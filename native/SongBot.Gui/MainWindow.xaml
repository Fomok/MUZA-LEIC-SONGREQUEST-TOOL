<Window x:Class="SongBot.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Song Bot" Width="1240" Height="900"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18" MaxWidth="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="🎵 Song " FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Bot" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                <TextBlock Text="   Twitch song requests → Discord voice" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Bottom" Margin="8,0,0,3" FontSize="12"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ================= MAIN COLUMN ================= -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">

                    <!-- MODE -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnModeDiscord" Grid.Column="0" Content="🎧 Discord VC bot"
                                        FontSize="15" FontWeight="SemiBold" Padding="10,12" Click="ModeDiscord_Click"/>
                                <Button x:Name="BtnModeApp" Grid.Column="1" Content="🖥 In App Player"
                                        FontSize="15" FontWeight="SemiBold" Padding="10,12" Margin="6,0,0,0" Click="ModeApp_Click"/>
                            </Grid>
                            <TextBlock x:Name="ModeHint" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                            <CheckBox x:Name="MirrorCheck" Content="🔊 also play on this PC (mirror of the bot)"
                                      Margin="0,8,0,0" Checked="Mirror_Changed" Unchecked="Mirror_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="OBS overlay (Browser Source, 960×280): " Foreground="{StaticResource Muted}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="📋 Copy link" FontSize="12" Padding="8,3" Click="CopyOverlay_Click"/>
                                <Button Content="📋 Copy transparent link" FontSize="12" Padding="8,3" Margin="6,0,0,0" Click="CopyOverlayClean_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- STATUS -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Ellipse x:Name="DotBot" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StBot" Text="…" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Ellipse x:Name="DotDiscord" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StDiscord" Text="…" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DotTwitch" Width="9" Height="9" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StTwitch" Text="…" Margin="6,0,0,0" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="↻ Restart bot" FontSize="12" Padding="8,3" Click="Restart_Click"/>
                                    <Button Content="⏻ Quit" Style="{StaticResource Danger}" FontSize="12" Padding="8,3" Margin="6,0,0,0" Click="Quit_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ErrLine" Foreground="{StaticResource Red}" FontSize="12.5"
                                       Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- NOW PLAYING -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8" Width="106" Height="60" Background="{StaticResource Panel2}" Margin="0,0,12,0">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,106,60" RadiusX="8" RadiusY="8"/>
                                    </Border.Clip>
                                    <Image x:Name="NpThumb" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NOW PLAYING " Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="NpSource" Foreground="{StaticResource Yellow}" FontSize="10.5" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NpTitle" Text="Nothing playing" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="NpBy" Foreground="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrev" Content="⏮" ToolTip="Play the previous song again" Click="Prev_Click"/>
                                    <Button x:Name="BtnPause" Content="⏸ Pause" Margin="6,0,0,0" Click="Pause_Click"/>
                                    <Button Content="⏭ Skip" Margin="6,0,0,0" Click="Skip_Click"/>
                                    <Button Content="⛔" Style="{StaticResource Danger}" Margin="6,0,0,0"
                                            ToolTip="Blacklist this song and skip it" Click="BlacklistCurrent_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeCur" Grid.Column="0" Text="0:00" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Slider x:Name="ProgSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="10,0"
                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        Thumb.DragStarted="Prog_DragStarted" Thumb.DragCompleted="Prog_DragCompleted"
                                        PreviewMouseUp="Prog_MouseUp"/>
                                <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="0:00" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SrEnabled" Grid.Column="3" Content="requests on" Margin="14,0,0,0" VerticalAlignment="Center"
                                          Checked="SrEnabled_Changed" Unchecked="SrEnabled_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- VOLUMES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🖥 App volume" FontSize="12.5" VerticalAlignment="Center"
                                           ToolTip="Loudness on this PC (In App Player and the mirror)"/>
                                <Slider x:Name="AppVolSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Margin="8,0"
                                        VerticalAlignment="Center" ValueChanged="AppVol_Changed"
                                        Thumb.DragCompleted="AppVol_Done" PreviewMouseUp="AppVol_Done"/>
                                <TextBlock x:Name="AppVolLabel" Grid.Column="2" Text="100%" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎧 Discord bot volume" FontSize="12.5" VerticalAlignment="Center"
                                           ToolTip="Loudness in the Discord voice channel"/>
                                <Slider x:Name="BotVolSlider" Grid.Column="1" Minimum="1" Maximum="150" Value="60" Margin="8,0"
                                        VerticalAlignment="Center" ValueChanged="BotVol_Changed"
                                        Thumb.DragCompleted="BotVol_Done" PreviewMouseUp="BotVol_Done"/>
                                <TextBlock x:Name="BotVolLabel" Grid.Column="2" Text="–%" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ADD SONG -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddBox" Grid.Column="0" KeyDown="AddBox_KeyDown"
                                     ToolTip="YouTube link or search"/>
                            <Button x:Name="BtnAdd" Grid.Column="1" Content="Add" Style="{StaticResource Primary}"
                                    Margin="8,0,0,0" MinWidth="70" Click="Add_Click"/>
                        </Grid>
                    </Border>

                    <!-- QUEUE -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="Bold">
                                    <Run Text="Queue ("/><Run x:Name="QCount" Text="0"/><Run Text=")"/>
                                </TextBlock>
                                <Button Grid.Column="1" Content="Clear queue" Style="{StaticResource Danger}"
                                        FontSize="12" Padding="8,3" Click="Clear_Click"/>
                            </Grid>
                            <TextBlock x:Name="QEmpty" Text="Queue is empty — viewers can type !sr &lt;song&gt; in Twitch chat."
                                       Foreground="{StaticResource Muted}" FontSize="12.5"/>
                            <ItemsControl x:Name="QueueList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Num}" Foreground="{StaticResource Accent2}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="64" Height="36" CornerRadius="4" Background="{StaticResource Panel2}" Margin="0,0,10,0">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,64,36" RadiusX="4" RadiusY="4"/>
                                                </Border.Clip>
                                                <Image Source="{Binding ThumbUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="⛔" Style="{StaticResource Danger}" FontSize="11" Padding="6,2"
                                                        Tag="{Binding Index}" ToolTip="Blacklist" Click="QueueBlacklist_Click"/>
                                                <Button Content="✕" Style="{StaticResource Danger}" FontSize="11" Padding="6,2"
                                                        Margin="4,0,0,0" Tag="{Binding Index}" ToolTip="Remove" Click="QueueRemove_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- SETTINGS -->
                    <Border Style="{StaticResource Card}">
                        <Expander Header="⚙️ Settings">
                            <StackPanel Margin="0,10,0,0">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Discord bot token" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="CfgDiscordToken"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Discord voice channel ID" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgVoiceChannelId"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Twitch channel (whose chat to watch)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgTwitchChannel"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Twitch bot account name (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgTwitchUsername"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Twitch oauth token (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <PasswordBox x:Name="CfgTwitchOauth"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Max song length (minutes, 0 = no limit)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgMaxSongMinutes"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Max queued songs per viewer (0 = no limit)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgMaxRequestsPerUser"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Max songs in the whole queue (0 = no limit)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgMaxQueueSize"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="&quot;Queue full&quot; chat message ({max} = limit)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgQueueFullMessage"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Command prefix" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgPrefix" MaxLength="3"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Text="Startup volume (%)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgDefaultVolume"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Audio quality (kbps, 32–320)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="CfgAudioBitrate"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Saving restarts the bot with the new settings."
                                               Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnSave" Grid.Column="1" Content="💾 Save &amp; restart"
                                            Style="{StaticResource Primary}" Click="Save_Click"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- LOGS -->
                    <Border Style="{StaticResource Card}">
                        <Expander Header="📜 Logs">
                            <TextBox x:Name="LogBox" IsReadOnly="True" Height="240" Margin="0,8,0,0"
                                     FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#0B0D10"
                                     Foreground="#A8B2C3" BorderThickness="1"/>
                        </Expander>
                    </Border>
                </StackPanel>

                <!-- ================= SIDE COLUMN ================= -->
                <StackPanel Grid.Column="1">

                    <!-- AUTO PLAYLIST -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="🎼 Auto playlist ("/><Run x:Name="PlCount" Text="0"/><Run Text=")"/>
                                </TextBlock>
                            </Grid>
                            <CheckBox x:Name="InterruptCheck" Content="requests interrupt instantly" FontSize="12.5"
                                      ToolTip="ON: a request skips the auto song immediately. OFF: the auto song finishes first."
                                      Checked="Interrupt_Changed" Unchecked="Interrupt_Changed"/>
                            <TextBlock Text="Plays random songs from this list whenever the request queue is empty."
                                       Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PlAddBox" Grid.Column="0" KeyDown="PlAddBox_KeyDown" ToolTip="YouTube link or search"/>
                                <Button x:Name="BtnPlAdd" Grid.Column="1" Content="Add" Style="{StaticResource Primary}"
                                        Margin="6,0,0,0" MinWidth="54" Click="PlAdd_Click"/>
                            </Grid>
                            <TextBlock x:Name="PlEmpty" Text="Empty — the bot stays silent between requests."
                                       Foreground="{StaticResource Muted}" FontSize="12"/>
                            <ItemsControl x:Name="PlList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Num}" Foreground="{StaticResource Accent2}"
                                                       FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="48" Height="27" CornerRadius="3" Background="{StaticResource Panel2}" Margin="0,0,8,0">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,48,27" RadiusX="3" RadiusY="3"/>
                                                </Border.Clip>
                                                <Image Source="{Binding ThumbUrl}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="▶" Style="{StaticResource Primary}" FontSize="10" Padding="6,1"
                                                        Tag="{Binding Index}" ToolTip="Play this song now" Click="PlPlayNow_Click"/>
                                                <Button Content="✕" Style="{StaticResource Danger}" FontSize="10" Padding="5,1"
                                                        Margin="3,0,0,0" Tag="{Binding Index}" ToolTip="Remove from playlist" Click="PlRemove_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- BLACKLIST -->
                    <Border Style="{StaticResource Card}">
                        <Expander>
                            <Expander.Header>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="⛔ Blacklist ("/><Run x:Name="BlCount" Text="0"/><Run Text=")"/>
                                </TextBlock>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock x:Name="BlEmpty" Text="Nothing blacklisted." Foreground="{StaticResource Muted}" FontSize="12"/>
                                <ItemsControl x:Name="BlList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="↩ allow" FontSize="10.5" Padding="6,2"
                                                        Tag="{Binding Index}" Click="BlRemove_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <TextBlock x:Name="Toast" Foreground="{StaticResource Accent2}" FontSize="12"
                               TextWrapping="Wrap" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
